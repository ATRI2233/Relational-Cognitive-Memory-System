{
  "general": {
    "description": "基本设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用 RCMS",
        "hint": "关闭后不注入关系上下文，插件相当于禁用。",
        "type": "bool",
        "default": true
      },
      "user_id": {
        "description": "用户标识（备用）",
        "hint": "当无法从事件获取发送者 ID 时使用的备用用户 ID。",
        "type": "string",
        "default": "default_user"
      }
    }
  },
  "analysis": {
    "description": "检索 + 蒸馏分析（含 API 凭证）",
    "type": "object",
    "items": {
      "retrieval": {
        "description": "语义检索：行为参数 + Embedding API 凭证",
        "type": "object",
        "items": {
          "embedding_enabled": {
            "description": "启用 Embedding 向量检索",
            "hint": "开启后使用 Embedding API 进行语义检索。需要下方配置有效的 API 凭证。关闭后通道 2 退化为关键词匹配。",
            "type": "bool",
            "default": true
          },
          "source": {
            "description": "API 来源",
            "hint": "astrbot：自动跟随 AstrBot 面板里当前生效的 Embedding 提供商（推荐，无需填 Key）；custom：使用下面手填的 Key 与模型。",
            "type": "string",
            "options": [
              "astrbot",
              "custom"
            ],
            "default": "astrbot"
          },
          "astrbot_source_id": {
            "description": "AstrBot 提供商 ID",
            "hint": "留空则自动使用当前生效的提供商；也可填提供商 ID 固定绑定。",
            "type": "string",
            "default": ""
          },
          "custom_api_key": {
            "description": "API Key（source=custom）",
            "hint": "仅 source=custom 时生效。",
            "type": "string",
            "default": ""
          },
          "custom_base_url": {
            "description": "API 地址（source=custom）",
            "hint": "仅 source=custom 时生效。",
            "type": "string",
            "default": "https://api.openai.com/v1"
          },
          "custom_model": {
            "description": "Embedding 模型名",
            "hint": "仅 source=custom 时生效；留空则沿用当前提供商。",
            "type": "string",
            "default": "text-embedding-3-small"
          },
          "total_cap": {
            "description": "三通道融合召回总上限",
            "hint": "三通道合并去重后的总召回条数",
            "type": "int",
            "default": 5,
            "min": 1,
            "max": 20
          },
          "fusion_floor_ratio": [
            {
              "description": "融合相对质量门槛",
              "hint": "候选加权分低于「本轮最高分 × 该比例」即视为不相关，即使通道有保底名额也让位。调高更严格（宁缺毋滥），调低更宽松。",
              "type": "float",
              "default": 0.35,
              "min": 0.0,
              "max": 1.0
            }
          ],
          "fusion_near_dup_ratio": [
            {
              "description": "近似去重阈值",
              "hint": "两条候选的字符 2-gram 相似度达到该值即视为同一条的重复表述，只保留分数更高的一条。",
              "type": "float",
              "default": 0.5,
              "min": 0.0,
              "max": 1.0
            }
          ],
          "resonance_fallback_on_empty": [
            {
              "description": "语义通道空命中时是否按重要性兜底",
              "hint": "默认关闭。开启后，即使当前话题与任何历史记忆都不相关，也会拿最近的高分记忆顶上，容易在闲聊时突然提起旧事。",
              "type": "bool",
              "default": false
            }
          ],
          "session_importance_boost": {
            "description": "当前会话条目重要性加成",
            "hint": "当轮对话产生的记忆在时间通道中的额外加权，值越大越偏向「刚刚聊过的」。",
            "type": "float",
            "default": 0.3,
            "min": 0.0,
            "max": 1.0
          },
          "embedding_cosine_threshold": {
            "description": "向量召回噪声下限",
            "hint": "低于此余弦值的记忆不进语义通道。这是绝对下限；实际门槛还会取「本批最高分 × 0.55」的较大者，所以换 embedding 模型也不用改这里。中文短句常见正确命中在 0.20~0.30，不建议调到 0.3 以上。",
            "type": "float",
            "default": 0.12,
            "min": 0.0,
            "max": 1.0
          },
          "channel_min": {
            "description": "每通道最低保底条数",
            "hint": "[ch1, ch2, ch3] 各自的最低保障数量",
            "type": "list",
            "default": [
              1,
              1,
              1
            ],
            "items": {
              "type": "int",
              "min": 0,
              "max": 10
            }
          },
          "time_decay_halflife": {
            "description": "重要性半衰期（天）",
            "hint": "值越小旧记忆衰减越快",
            "type": "int",
            "default": 30,
            "min": 1,
            "max": 365
          },
          "emotional_resonance_bonus": {
            "description": "情绪共振加成系数",
            "hint": "当前情绪与记忆情绪匹配时的分数倍率加成，0.15 表示 ×1.15",
            "type": "float",
            "default": 0.15,
            "min": 0,
            "max": 1.0
          }
        }
      },
      "post_analysis": {
        "description": "蒸馏分析：LLM API 凭证 + 行为参数",
        "type": "object",
        "items": {
          "source": {
            "description": "API 来源",
            "hint": "astrbot：自动跟随 AstrBot 面板里当前生效的对话模型（推荐，无需填 Key）；custom：使用下面手填的 Key 与模型。",
            "type": "string",
            "options": [
              "astrbot",
              "custom"
            ],
            "default": "astrbot"
          },
          "astrbot_source_id": {
            "description": "AstrBot 提供商 ID",
            "hint": "留空则自动使用当前生效的提供商；也可填提供商 ID 固定绑定。",
            "type": "string",
            "default": ""
          },
          "custom_api_key": {
            "description": "API Key（source=custom）",
            "hint": "仅 source=custom 时生效。",
            "type": "string",
            "default": ""
          },
          "custom_base_url": {
            "description": "API 地址（source=custom）",
            "hint": "仅 source=custom 时生效。",
            "type": "string",
            "default": "https://api.openai.com/v1"
          },
          "custom_model": {
            "description": "蒸馏模型名",
            "hint": "仅 source=custom 时生效；留空则沿用当前提供商。",
            "type": "string",
            "default": "gpt-4o-mini"
          },
          "max_turns": {
            "description": "最大蒸馏间隔（轮数）",
            "hint": "对话达到此轮数后自动触发 LLM 蒸馏分析",
            "type": "int",
            "default": 30,
            "min": 5,
            "max": 200
          },
          "max_minutes": {
            "description": "最大蒸馏间隔（分钟）",
            "hint": "距离上次蒸馏超过此分钟数则触发",
            "type": "int",
            "default": 60,
            "min": 5,
            "max": 1440
          },
          "catch_up_on_start": {
            "description": "启动时补蒸",
            "hint": "聊了几轮没到门槛就关掉程序、之后不再回那个会话时，这些对话原本永远变不成记忆。开启后插件启动时会补一次。",
            "type": "bool",
            "default": true
          },
          "catch_up_max_sessions": {
            "description": "启动补蒸上限（会话数）",
            "hint": "一次启动最多补几个会话，避免攒了很多会话时开机连打一串模型请求。",
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 10
          },
          "dangling_expire_turns": {
            "description": "悬案过期轮数",
            "hint": "未完成话题超过此轮数无人提起则自动归档",
            "type": "int",
            "default": 15,
            "min": 3,
            "max": 100
          }
        }
      }
    }
  },
  "output_log": {
    "description": "输出日志",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用输出日志",
        "hint": "每次回复后记录 JSONL 日志，用于分析对话模式。日志不会写入插件目录。",
        "type": "bool",
        "default": true
      },
      "max_size_mb": {
        "description": "日志最大体积 (MB)",
        "hint": "超出后自动从头部删除最旧条目。",
        "type": "int",
        "default": 5,
        "min": 1,
        "max": 100
      },
      "path": {
        "description": "日志文件路径",
        "hint": "相对路径会写入记忆库目录（storage.data_dir），避免升级插件时被删除；也可填绝对路径。",
        "type": "string",
        "default": "rcms_output.jsonl"
      }
    }
  },
  "storage": {
    "description": "存储",
    "type": "object",
    "items": {
      "data_dir": {
        "description": "记忆库目录",
        "hint": "留空使用 AstrBot 数据区的 plugin_data/astrbot_plugin_rcms。注意：升级插件会删除插件目录，别把 data_dir 设在插件目录内，否则记忆库会丢。",
        "type": "string",
        "default": ""
      }
    }
  },
  "webui": {
    "description": "本地观测站",
    "type": "object",
    "hint": "插件自带的只读网页，用浏览器打开 http://127.0.0.1:端口 就能看到每张表的数据和三路召回的合成细节。",
    "items": {
      "enabled": {
        "description": "启用观测站",
        "hint": "关闭后不启动本地服务，也不会记录召回追踪。",
        "type": "bool",
        "default": true
      },
      "host": {
        "description": "监听地址",
        "hint": "默认只监听本机回环地址；改成 0.0.0.0 会把记忆库暴露到局域网，不建议。",
        "type": "string",
        "default": "127.0.0.1"
      },
      "port": {
        "description": "端口",
        "hint": "默认 8765；被占用时会自动往后顺延，实际地址见日志。",
        "type": "int",
        "default": 8765
      },
      "trace_enabled": {
        "description": "记录召回追踪",
        "hint": "每次构建提示词时记录三条通道的候选与融合过程，用于观测「历史提示词是怎么拼出来的」。",
        "type": "bool",
        "default": true
      },
      "trace_max": {
        "description": "追踪保留条数",
        "hint": "超出后自动删除最旧的记录。",
        "type": "int",
        "default": 200
      }
    }
  }
}

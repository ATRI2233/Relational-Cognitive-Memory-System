{
  "general": {
    "description": "基本设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用 RCMS",
        "hint": "关闭后不注入关系上下文，插件相当于禁用。",
        "type": "bool",
        "default": true
      },
      "persona_separated": {
        "description": "按人格隔离记忆",
        "hint": "启用后每个人格使用独立数据库，不同人格的记忆互不干扰。关闭则统一使用一个记忆库。",
        "type": "bool",
        "default": true
      },
      "user_id": {
        "description": "用户标识（备用）",
        "hint": "当无法从事件获取发送者 ID 时使用的备用用户 ID。",
        "type": "string",
        "default": "default_user"
      },
      "injection_method": {
        "description": "RCMS 上下文注入方式",
        "hint": "system_prompt：追加到人格提示词尾部；prompt_prefix：放在用户消息前；faketool：以工具调用结果注入。",
        "type": "string",
        "default": "system_prompt",
        "options": ["system_prompt", "prompt_prefix", "faketool"]
      }
    }
  },
  "analysis": {
    "description": "检索 + 蒸馏分析（含 API 凭证）",
    "type": "object",
    "items": {
      "retrieval": {
        "description": "语义检索：行为参数 + Embedding API 凭证",
        "type": "object",
        "items": {
          "embedding_enabled": {
            "description": "启用 Embedding 向量检索",
            "hint": "开启后使用 Embedding API 进行语义检索。需要下方配置有效的 API 凭证。关闭后通道 2 退化为关键词匹配。",
            "type": "bool",
            "default": true
          },
          "source": {
            "description": "API 来源",
            "hint": "astrbot：从 AstrBot 配置读取；custom：手动输入",
            "type": "string",
            "default": "astrbot",
            "options": ["astrbot", "custom"]
          },
          "astrbot_source_id": {
            "description": "AstrBot 提供商 ID",
            "hint": "AstrBot cmd_config.json 中 provider_sources 的 id，留空自动匹配",
            "type": "string",
            "default": ""
          },
          "custom_api_key": {
            "description": "API Key（source=custom）",
            "hint": "仅在 source=custom 时生效",
            "type": "string",
            "default": ""
          },
          "custom_base_url": {
            "description": "API 地址（source=custom）",
            "hint": "仅在 source=custom 时生效",
            "type": "string",
            "default": "https://api.openai.com/v1"
          },
          "custom_model": {
            "description": "Embedding 模型名",
            "hint": "默认 text-embedding-3-small",
            "type": "string",
            "default": "text-embedding-3-small"
          },
          "total_cap": {
            "description": "三通道融合召回总上限",
            "hint": "三通道合并去重后的总召回条数",
            "type": "int",
            "default": 5,
            "min": 1,
            "max": 20
          },
          "channel_min": {
            "description": "每通道最低保底条数",
            "hint": "[ch1, ch2, ch3] 各自的最低保障数量",
            "type": "list",
            "default": [1, 1, 1],
            "items": {"type": "int", "min": 0, "max": 10}
          },
          "time_decay_halflife": {
            "description": "重要性半衰期（天）",
            "hint": "值越小旧记忆衰减越快",
            "type": "int",
            "default": 30,
            "min": 1,
            "max": 365
          },
          "emotional_resonance_bonus": {
            "description": "情绪共振加成系数",
            "hint": "当前情绪与记忆情绪匹配时的分数倍率加成，0.15 表示 ×1.15",
            "type": "float",
            "default": 0.15,
            "min": 0,
            "max": 1.0
          }
        }
      },
      "post_analysis": {
        "description": "蒸馏分析：LLM API 凭证 + 行为参数",
        "type": "object",
        "items": {
          "source": {
            "description": "API 来源",
            "hint": "astrbot：从 AstrBot 配置读取；custom：手动输入",
            "type": "string",
            "default": "astrbot",
            "options": ["astrbot", "custom"]
          },
          "astrbot_source_id": {
            "description": "AstrBot 提供商 ID",
            "hint": "留空自动匹配当前启用的提供商",
            "type": "string",
            "default": ""
          },
          "custom_api_key": {
            "description": "API Key（source=custom）",
            "hint": "仅在 source=custom 时生效",
            "type": "string",
            "default": ""
          },
          "custom_base_url": {
            "description": "API 地址（source=custom）",
            "hint": "仅在 source=custom 时生效",
            "type": "string",
            "default": "https://api.openai.com/v1"
          },
          "custom_model": {
            "description": "蒸馏模型名",
            "hint": "推荐 gpt-4o-mini 成本低效果够",
            "type": "string",
            "default": "gpt-4o-mini"
          },
          "max_turns": {
            "description": "最大蒸馏间隔（轮数）",
            "hint": "对话达到此轮数后自动触发 LLM 蒸馏分析",
            "type": "int",
            "default": 30,
            "min": 5,
            "max": 200
          },
          "max_minutes": {
            "description": "最大蒸馏间隔（分钟）",
            "hint": "距离上次蒸馏超过此分钟数则触发",
            "type": "int",
            "default": 60,
            "min": 5,
            "max": 1440
          },
          "dangling_expire_turns": {
            "description": "悬案过期轮数",
            "hint": "未完成话题超过此轮数无人提起则自动归档",
            "type": "int",
            "default": 15,
            "min": 3,
            "max": 100
          }
        }
      }
    }
  },
  "output_log": {
    "description": "输出日志",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用输出日志",
        "hint": "每次回复后记录 JSONL 日志，用于分析对话模式。",
        "type": "bool",
        "default": true
      },
      "max_size_mb": {
        "description": "日志最大体积 (MB)",
        "hint": "超出后自动从头部删除最旧条目。",
        "type": "int",
        "default": 5,
        "min": 1,
        "max": 100
      },
      "path": {
        "description": "日志文件路径",
        "hint": "相对插件目录或绝对路径。",
        "type": "string",
        "default": "rcms_output.jsonl"
      }
    }
  },
  "debug": {
    "description": "调试",
    "type": "object",
    "items": {
      "log_level": {
        "description": "日志级别",
        "hint": "debug 输出详细 pipeline 日志，info 只输出关键信息。",
        "type": "string",
        "default": "info",
        "options": ["debug", "info", "warning"]
      }
    }
  }
}

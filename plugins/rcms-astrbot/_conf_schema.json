{
  "general": {
    "description": "基本设置",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用 RCMS",
        "hint": "关闭后不注入关系上下文，插件相当于禁用。",
        "type": "bool",
        "default": true
      },
      "persona_separated": {
        "description": "按人格隔离记忆",
        "hint": "启用后每个人格使用独立数据库，不同人格的记忆互不干扰。关闭则统一使用一个记忆库。",
        "type": "bool",
        "default": true
      },
      "user_id": {
        "description": "用户标识（备用）",
        "hint": "当无法从事件获取发送者 ID 时使用的备用用户 ID。正常情况下会自动使用实际发送者 ID。",
        "type": "string",
        "default": "default_user"
      },
      "injection_method": {
        "description": "RCMS 上下文注入方式",
        "hint": "system_prompt：追加到人格提示词尾部；prompt_prefix：放在用户消息前；faketool：以工具调用结果注入，与人格完全隔离。",
        "type": "string",
        "default": "system_prompt",
        "options": ["system_prompt", "prompt_prefix", "faketool"]
      }
    }
  },
  "memory": {
    "description": "记忆管理",
    "type": "object",
    "items": {
      "enable_auto_save": {
        "description": "自动保存对话到记忆",
        "hint": "每次对话后是否自动将内容写入长期记忆。",
        "type": "bool",
        "default": true
      },
      "max_memories_per_prompt": {
        "description": "每次注入最大记忆数",
        "hint": "每次 LLM 请求最多注入几条相关记忆到 system_prompt。",
        "type": "int",
        "default": 2,
        "min": 0,
        "max": 10
      }
    }
  },
  "analysis": {
    "description": "分析与检索（含 API 凭证）",
    "type": "object",
    "items": {
      "retrieval": {
        "description": "语义检索：行为参数 + Embedding API 凭证",
        "type": "object",
        "items": {
          "enabled": {
            "description": "启用语义检索",
            "hint": "开启后使用 Embedding API 进行语义检索，替代关键词 LIKE 检索。需要下方配置有效的 API 凭证。",
            "type": "bool",
            "default": true
          },
          "source": {
            "description": "API 来源",
            "hint": "astrbot：外部读取 AstrBot 已配置的模型提供商；custom：手动输入 URL/Token/模型",
            "type": "string",
            "default": "astrbot",
            "options": ["astrbot", "custom"]
          },
          "astrbot_source_id": {
            "description": "AstrBot 提供商 ID（source=astrbot）",
            "hint": "AstrBot cmd_config.json 中 provider_sources 的 id，留空自动匹配当前启用的提供商",
            "type": "string",
            "default": ""
          },
          "custom_url": {
            "description": "自定义 API 地址（source=custom）",
            "hint": "仅在 source=custom 时生效",
            "type": "string",
            "default": "https://api.openai.com/v1"
          },
          "custom_token": {
            "description": "自定义 API Token（source=custom）",
            "hint": "仅在 source=custom 时生效",
            "type": "string",
            "default": ""
          },
          "custom_model": {
            "description": "自定义模型名（source=custom）",
            "hint": "仅在 source=custom 时生效",
            "type": "string",
            "default": "text-embedding-3-small"
          },
          "total_cap": {
            "description": "三通道融合召回总上限",
            "hint": "三通道合并去重后的总召回条数",
            "type": "int",
            "default": 5,
            "min": 1,
            "max": 20
          },
          "channel_min": {
            "description": "每通道最低保底条数",
            "hint": "三个通道各自的最低保障数量，格式为 [ch1, ch2, ch3]",
            "type": "list",
            "default": [1, 1, 1],
            "items": {"type": "int", "min": 0, "max": 10}
          },
          "time_decay_halflife": {
            "description": "重要性半衰期（天）",
            "hint": "importance 的时间衰减半衰期，值越小旧记忆衰减越快",
            "type": "int",
            "default": 30,
            "min": 1,
            "max": 365
          },
          "emotional_resonance_bonus": {
            "description": "情绪共振加成系数",
            "hint": "当前情绪与记忆情绪匹配时的分数倍率加成，0.15 表示 ×1.15",
            "type": "float",
            "default": 0.15,
            "min": 0,
            "max": 1.0
          }
        }
      },
      "post_analysis": {
        "description": "事后分析：行为参数 + LLM API 凭证",
        "type": "object",
        "items": {
          "mode": {
            "description": "分析模式",
            "hint": "rule：纯规则（免费）；llm：调用 LLM 分析对话并更新长期记忆表。需要下方配置有效的 API 凭证。",
            "type": "string",
            "default": "rule",
            "options": ["rule", "llm"]
          },
          "sampling": {
            "description": "LLM 分析采样率",
            "hint": "1.0=每次都分析，0.1=平均每10轮一次，0=永不。仅在 mode=llm 时生效。",
            "type": "float",
            "default": 0.1,
            "min": 0,
            "max": 1.0
          },
          "source": {
            "description": "API 来源",
            "hint": "astrbot：外部读取 AstrBot 已配置的模型提供商；custom：手动输入 URL/Token/模型",
            "type": "string",
            "default": "astrbot",
            "options": ["astrbot", "custom"]
          },
          "astrbot_source_id": {
            "description": "AstrBot 提供商 ID（source=astrbot）",
            "hint": "AstrBot cmd_config.json 中 provider_sources 的 id，留空自动匹配当前启用的提供商",
            "type": "string",
            "default": ""
          },
          "custom_url": {
            "description": "自定义 API 地址（source=custom）",
            "hint": "仅在 source=custom 时生效",
            "type": "string",
            "default": "https://api.openai.com/v1"
          },
          "custom_token": {
            "description": "自定义 API Token（source=custom）",
            "hint": "仅在 source=custom 时生效",
            "type": "string",
            "default": ""
          },
          "custom_model": {
            "description": "自定义模型名（source=custom）",
            "hint": "仅在 source=custom 时生效，推荐 gpt-4o-mini 成本低效果够",
            "type": "string",
            "default": "gpt-4o-mini"
          }
        }
      }
    }
  },
  "output_log": {
    "description": "输出日志",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用输出日志",
        "hint": "每次回复后记录 JSONL 日志，用于分析对话模式。",
        "type": "bool",
        "default": true
      },
      "max_size_mb": {
        "description": "日志最大体积 (MB)",
        "hint": "超出后自动从头部删除最旧条目。",
        "type": "int",
        "default": 5,
        "min": 1,
        "max": 100
      },
      "path": {
        "description": "日志文件路径",
        "hint": "相对插件目录或绝对路径。",
        "type": "string",
        "default": "rcms_output.jsonl"
      }
    }
  },
  "debug": {
    "description": "调试",
    "type": "object",
    "items": {
      "log_level": {
        "description": "日志级别",
        "hint": "debug 会输出详细 pipeline 日志，info 只输出关键信息。",
        "type": "string",
        "default": "info",
        "options": ["debug", "info", "warning"]
      }
    }
  }
}
